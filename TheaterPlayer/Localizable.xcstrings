    "Skips the video or music playing in the theater back by the duration you choose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Springt in der Video- oder Musikwiedergabe im Kino um die gewählte Dauer zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait reculer de la durée choisie la vidéo ou la musique en cours de lecture dans la salle de cinéma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画館で再生している動画・音楽を、指定した長さだけ戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "극장에서 재생 중인 비디오 또는 음악을 선택한 길이만큼 뒤로 건너뜁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将影院中正在播放的视频或音乐快退所选的时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將電影院中正在播放的影片或音樂倒轉你選擇的時間長度。"
          }
        }
      }
    },
