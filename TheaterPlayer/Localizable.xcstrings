      }
    },
    "This isn’t a picture or a PDF." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist weder ein Bild noch ein PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est ni une image ni un PDF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像・PDF ではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지 또는 PDF가 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件不是图片或 PDF。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這不是圖片或 PDF。"
          }
        }
      }
    },
    "To play videos, music, pictures, and PDFs you put in this folder, use “Choose a File” in the Theater Player library and open this folder.\nYou can delete this file. When the folder is empty, it no longer appears in the Files app, so Theater Player puts this file back the next time you open it.\n" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Videos, Musik, Bilder und PDFs wiederzugeben, die du in diesen Ordner legst, wähle in der Mediathek von Theater Player „Datei auswählen“ und öffne diesen Ordner.\nDu kannst diese Datei löschen. Ist der Ordner leer, wird er in der „Dateien“-App nicht mehr angezeigt. Deshalb legt Theater Player diese Datei wieder hier ab, wenn du die App das nächste Mal öffnest.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour lire les vidéos et la musique, ou afficher les images et les PDF placés dans ce dossier, utilisez « Choisir un fichier » dans la bibliothèque de Theater Player, puis ouvrez ce dossier.\nVous pouvez supprimer ce fichier. Lorsque le dossier est vide, il n’apparaît plus dans l’app Fichiers. Theater Player remet donc ce fichier en place à sa prochaine ouverture.\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダに入れた動画・音楽・画像・PDF は、Theater Player のライブラリの「ファイルを選ぶ」で、このフォルダを開いて選べます。\nこのファイルは消してもかまいません。フォルダが空になると「ファイル」App に出なくなるので、次に Theater Player を開いたときにまた置きます。\n"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 폴더에 넣은 비디오, 음악, 이미지 및 PDF를 재생하려면 Theater Player 보관함에서 ‘파일 선택’을 사용하여 이 폴더를 여십시오.\n이 파일은 삭제해도 됩니다. 폴더가 비어 있으면 파일 앱에 더 이상 표시되지 않으므로, 다음에 Theater Player를 열 때 이 파일이 다시 추가됩니다.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要播放存放在此文件夹中的视频、音乐、图片和 PDF，请在 Theater Player 的资料库中使用“选取文件”，然后打开此文件夹。\n你可以删除此文件。文件夹为空时不会显示在“文件”App 中，因此下次打开 Theater Player 时，App 会重新放回此文件。\n"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要播放放在此資料夾中的影片、音樂、圖片和 PDF，請在 Theater Player 的資料庫中使用「選擇檔案」，然後打開此資料夾。\n你可以刪除此檔案。資料夾為空時就不會再出現在「檔案」App 中，因此 Theater Player 會在你下次打開它時將此檔案放回。\n"
          }
        }
      }
    },
    "Top and bottom halves (TAB, OU)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
