    },
    "Track %lld" : {
      "comment" : "Audio track without a name. The number is the stream index.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラック %lld"
          }
        }
      }
    },
    "Use “Choose a File” to open videos, music, pictures, and PDFs in iCloud Drive or on external storage.\nYou can also open files you put in the TheaterPlayer folder in the Files app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ファイルを選ぶ」から、iCloud Drive や外部ストレージの動画・音楽・画像・PDF を開けます\n「ファイル」App の TheaterPlayer のフォルダに入れたものも開けます"
          }
        }
      }
    },
    "Virtual Bass (Harmonics You Can Feel)" : {
      "localizations" : {
