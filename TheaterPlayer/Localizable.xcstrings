    "Plays videos such as MKV, MP4, AVI, WMV, and TS, and music such as FLAC, MP3, AAC, and WAV. Also shows pictures such as PNG, JPEG, and HEIC, and PDFs." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MKV・MP4・AVI・WMV・TS などの動画と、FLAC・MP3・AAC・WAV などの音楽を再生できます。PNG・JPEG・HEIC などの画像と PDF も映せます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
