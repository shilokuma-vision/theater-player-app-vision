          }
        }
      }
    },
    "Use “Choose a File” to open videos, music, pictures, and PDFs in iCloud Drive or on external storage.\nYou can also open files you put in the Theater Player folder in the Files app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ファイルを選ぶ」から、iCloud Drive や外部ストレージの動画・音楽・画像・PDF を開けます\n「ファイル」App の Theater Player のフォルダに入れたものも開けます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“选取文件”可打开 iCloud云盘 或外置储存设备中的视频、音乐、图片和 PDF。\n也可以打开存放在“文件”App 的 Theater Player 文件夹中的文件。"
          }
        }
      }
    },
    "Virtual Bass (Harmonics You Can Feel)" : {
