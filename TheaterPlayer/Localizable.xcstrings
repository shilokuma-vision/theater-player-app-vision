    "Plays videos such as MKV, MP4, AVI, WMV, and TS, and music such as FLAC, MP3, AAC, and WAV. Also shows pictures such as PNG, JPEG, and HEIC, and PDFs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt Videos wie MKV, MP4, AVI, WMV und TS sowie Musik wie FLAC, MP3, AAC und WAV wieder. Zeigt außerdem Bilder wie PNG, JPEG und HEIC sowie PDFs an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit des vidéos (MKV, MP4, AVI, WMV, TS, etc.) et de la musique (FLAC, MP3, AAC, WAV, etc.). Affiche aussi des images (PNG, JPEG, HEIC, etc.) et des PDF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MKV・MP4・AVI・WMV・TS などの動画と、FLAC・MP3・AAC・WAV などの音楽を再生できます。PNG・JPEG・HEIC などの画像と PDF も映せます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MKV, MP4, AVI, WMV, TS 등의 비디오와 FLAC, MP3, AAC, WAV 등의 음악을 재생합니다. PNG, JPEG, HEIC 등의 이미지와 PDF도 표시합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可播放 MKV、MP4、AVI、WMV、TS 等视频，以及 FLAC、MP3、AAC、WAV 等音乐，还可显示 PNG、JPEG、HEIC 等图片和 PDF。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可播放 MKV、MP4、AVI、WMV 和 TS 等影片，以及 FLAC、MP3、AAC 和 WAV 等音樂。也可顯示 PNG、JPEG 和 HEIC 等圖片，以及 PDF。"
          }
        }
      }
