    "Use “Choose a File” to open videos, music, pictures, and PDFs in iCloud Drive or on external storage.\nYou can also open files you put in the Theater Player folder in the Files app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Datei auswählen“ kannst du Videos, Musik, Bilder und PDFs aus iCloud Drive oder von externen Speichermedien öffnen.\nDu kannst auch Dateien öffnen, die du in der „Dateien“-App in den Ordner „Theater Player“ gelegt hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez « Choisir un fichier » pour ouvrir des vidéos, de la musique, des images et des PDF stockés sur iCloud Drive ou sur un stockage externe.\nVous pouvez aussi ouvrir les fichiers placés dans le dossier Theater Player de l’app Fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ファイルを選ぶ」から、iCloud Drive や外部ストレージの動画・音楽・画像・PDF を開けます\n「ファイル」App の Theater Player のフォルダに入れたものも開けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘파일 선택’을 사용하여 iCloud Drive 또는 외장 저장 장치에 있는 비디오, 음악, 이미지 및 PDF를 열 수 있습니다.\n파일 앱의 Theater Player 폴더에 넣은 파일도 열 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“选取文件”可打开 iCloud云盘 或外置储存设备中的视频、音乐、图片和 PDF。\n也可以打开存放在“文件”App 的 Theater Player 文件夹中的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「選擇檔案」來打開 iCloud雲碟 或外接儲存裝置中的影片、音樂、圖片和 PDF。\n你也可以打開放在「檔案」App 中 Theater Player 資料夾內的檔案。"
          }
        }
      }
    },
    "Virtual Bass (Harmonics You Can Feel)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtueller Bass (spürbare Obertöne)"
