<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store に提出するアプリのプライバシーマニフェスト。機能を足したら、この内容が実態と合っているか見直す -->
	<!-- トラッキング（ATT の対象）をしないなら false のまま。広告 SDK などでトラッキングするなら true にし、ドメインを列挙する -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- 収集するデータ。App Store Connect の「App のプライバシー」と揃える -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- 理由の申告が必要な API。@AppStorage / UserDefaults はほぼすべてのアプリが使うため、最初から申告しておく -->
	<!-- ファイルのタイムスタンプ・空き容量・起動時刻などの API を使うときは、ここに理由を足す -->
	<!-- 静的にリンクした FFmpeg が使う API も、このアプリの申告になる（確かめ方は README の「プライバシーマニフェスト」） -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: アプリ自身だけが読み書きする設定・状態の保存 -->
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- File timestamp: FFmpeg の stat・fstat・lstat。開いたファイルの大きさと種類を fstat で見る（libavformat/file.c の file のプロトコル）。
		     lstat（同じ file.c のフォルダーの一覧）・stat（libavformat/img2dec.c の ts_from_file）は参照だけで、このアプリは使わない -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: アプリのコンテナの中のファイル（写真から選んで Caches/PickedMovies にコピーした物） -->
				<string>C617.1</string>
				<!-- 3B52.1: 利用者がファイルの選択（fileImporter）で選んだファイル（最近の項目のブックマークから開き直す物を含む） -->
				<string>3B52.1</string>
			</array>
		</dict>
		<!-- System boot time: TheaterMedia の mach_absolute_time（MediaPlayer+Playback.swift）。音を最後に鳴らした時刻からの経過で映像を音に合わせる・診断のログの間隔 -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 35F9.1: アプリの中の出来事のあいだの経過時間を測る（端末の外には送らない） -->
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
